# ---- Slack (python app.py) ----
# Bot User OAuth Token (OAuth & Permissions page), starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-token
# App-Level Token with connections:write scope (Basic Information page), starts with xapp-
SLACK_APP_TOKEN=xapp-your-token
# RPG_ANNOUNCE_CHANNEL=C0123456 # Slack channel ID for level-ups / boss kills
# RPG_SLASH_COMMAND=/rpg

# ---- Discord (python discord_bot.py) ----
# Developer Portal -> your application -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_GUILD_ID=123456789012345678           # your server ID: makes /rpg appear instantly
# DISCORD_ANNOUNCE_CHANNEL_ID=123456789012345678 # channel for level-ups / boss kills

# ---- Shared ----
# RPG_PUBLIC=false   # true = every game reply is visible to the whole channel
# RPG_DB_PATH=rpg.db # where saves are stored (Slack and Discord can share one file)
